# ── Environment Configuration ─────────────────────────────────
# Copy this file to .env and fill in actual values.
# NEVER commit .env with real credentials.

# Application
APP_NAME=Tatkal Agent Backend
APP_ENV=development
API_VERSION=v1
DEBUG=true

# Server
HOST=127.0.0.1
PORT=8000

# Database (SQLite — relative path resolved from project root)
DATABASE_URL=sqlite:///data/tatkal_agent.db

# Logging
LOG_LEVEL=INFO

# Storage
ARTIFACT_DIR=artifacts
DATA_DIR=data

# CORS — comma-separated origins allowed for frontend dev
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Model Provider (optional — app starts without these)
# MODEL_PROVIDER=openai
# MODEL_API_KEY=sk-your-key-here
# MODEL_NAME=gpt-4o
# MODEL_BASE_URL=

# Tool Adapters & Skills (Phase 4)
ENABLE_BROWSER_ADAPTER=true
BROWSER_HEADLESS=true
BROWSER_NAVIGATION_TIMEOUT=30.0
BROWSER_ACTION_TIMEOUT=15.0

ENABLE_DESKTOP_ADAPTER=false
DESKTOP_ACTION_TIMEOUT=10.0

SKILLS_DIR=app/skills/definitions
MAX_ARTIFACT_SIZE_BYTES=5242880
MAX_OBSERVATION_TEXT_CHARS=5000

# Recovery & Resilience (Phase 6)
RECOVERY_MAX_ATTEMPTS=3
RECOVERY_INITIAL_BACKOFF=0.5
RECOVERY_BACKOFF_MULTIPLIER=2.0
RECOVERY_MAX_BACKOFF=5.0
RECOVERY_MAX_CUMULATIVE_TIME=30.0

CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN_SECONDS=30.0
CIRCUIT_BREAKER_HALF_OPEN_PROBES=1
CIRCUIT_BREAKER_WINDOW_SECONDS=60.0

# Audit, Evidence & Compliance (Phase 7)
AUDIT_ENABLED=true
EVIDENCE_RETENTION_DAYS=30
EVIDENCE_CAPTURE_SCREENSHOTS=true

# Railway Data Providers (Phase 9)
RAILWAY_PROVIDER=hybrid
# RAILWAY_API_KEY=your-rapidapi-key-here
RAILWAY_API_HOST=indian-railway-irctc.p.rapidapi.com
RAILWAY_API_BASE_URL=https://indian-railway-irctc.p.rapidapi.com
RAILWAY_TIMEOUT_SECONDS=5.0
